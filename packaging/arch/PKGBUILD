# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oosha256-bin
_pkgname=oosha256
pkgver=0.1.0
pkgrel=1
pkgdesc="Hardware-accelerated SHA-256 cryptographic digest generator and verifier."
arch=('x86_64')
url="https://github.com/openOODA-tools/oosha256"
license=('Apache-2.0')
depends=('glibc')
provides=('oosha256')
conflicts=('oosha256')
source_x86_64=("${url}/releases/download/v${pkgver}/oosha256-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oosha256-linux-x86_64" "${pkgdir}/usr/bin/oosha256"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oosha256-uninstall"
}
